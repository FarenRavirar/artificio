{
  "mcpServers": {
    "code-review-graph": {
      "command": "uvx",
      "args": [
        "code-review-graph@2.3.7",
        "serve"
      ],
      "type": "stdio"
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@4.4.4"
      ],
      "env": {}
    },
    "magic": {
      "type": "stdio",
      "command": "node",
      "args": [
        "scripts/mcp/launch-magic.js"
      ]
    }
  }
}
