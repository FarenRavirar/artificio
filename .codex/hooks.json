{
  "description": "Hooks de governanca do Artificio RPG para o Codex. Spec 101, Fase 0.7 (D14). Os gates PreToolUse compartilham implementacao com o Claude Code; os hooks Stop tambem sao compartilhados, mas registro-anti-compactacao interpreta os dois formatos de transcript. O caminho resolve a raiz por 'git rev-parse --show-toplevel' porque a sessao pode comecar num subdiretorio.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook codex"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/rtk-enforce.js\""
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/git-commit-msg-gate.js\""
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/autorizacao-gate.js\""
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/beta-antes-de-prod.js\"",
            "timeout": 90
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/rtk-read-gate.js\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/deploy-contract-gate.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/registro-anti-compactacao.js\""
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/caveman-resposta-final.js\""
          }
        ]
      }
    ]
  }
}
