---
// Busca estática Pagefind, Component UI (custom elements), não o `PagefindUI` da API
// antiga. Os assets /pagefind/* são gerados no postbuild (pagefind --site dist), então a
// busca funciona no build/preview, não no `astro dev`.
//
// ⚠️ A DOC OFICIAL DÁ O ARQUIVO ERRADO PARA ESTE REPO.
// `pagefind.app/docs/components/input/` manda carregar `/pagefind/pagefind-ui.js`, que
// aqui define ZERO custom elements (medido: `grep -o 'customElements.define'` devolve 0
// nele e 13 em `pagefind-component-ui.js`). Quem define `pagefind-modal` e companhia é
// `pagefind-component-ui.js`. Copiar a doc sem medir o bundle repetiria a falha que criou
// esta task (T7.8, spec 102): o código anterior foi escrito contra `PagefindUI`, API
// substituída pelo Component UI na Pagefind 1.5.0, com a 1.5.2 instalada.
//
// ⚠️ O bundle é IIFE, não ES module: termina em `window.PagefindComponents=...`. A doc
// oferece `import '@pagefind/component-ui'`, que aqui NÃO funciona — o arquivo servido em
// `/pagefind/` não exporta nada. O acesso programático é pela global.
//
// `lang="pt-br"`: o Component UI monta os candidatos `pt-BR` e depois `pt` (medido no
// bundle), e `translations/pt.json` existe. Por isso não passamos `translations` à mão,
// como a versão anterior fazia.
//
// `instance="overlay"` distingue esta busca da `/busca/` (`instance="search-page"`).
// Instâncias distintas não compartilham termo nem resultado — é o que resolve, por
// desenho, a colisão de `id="pagefind-search"` que a API antiga produzia por não
// documentar duas instâncias no mesmo documento.
---
<link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />

<pagefind-config instance="overlay" lang="pt-br"></pagefind-config>
<pagefind-modal id="search-modal" instance="overlay" reset-on-close></pagefind-modal>

{/*
  `<script>` sem `is:inline`: o Astro bundla e hasheia sozinho para a CSP
  (`astro.config.mjs` §security.csp). Inline exigiria hash à mão na config, que é a
  armadilha registrada em T7.6 — foi ela que deixou a `/busca/` com o script bloqueado.
*/}
<script>
  (function () {
    var COMPONENT_UI = "/pagefind/pagefind-component-ui.js";
    var loading: Promise<void> | null = null;

    // A lupa vive na ilha React do header (`SiteHeaderIsland.tsx`), que dispara
    // `artificio:open-search`. Por isso NÃO usamos `<pagefind-modal-trigger>`: ele
    // desenharia um segundo botão de busca no documento.
    function loadComponentUI() {
      if (loading) return loading;
      loading = new Promise<void>(function (resolve, reject) {
        var script = document.createElement("script");
        script.src = COMPONENT_UI;
        script.onload = function () {
          resolve();
        };
        script.onerror = function () {
          reject(new Error("falha ao carregar " + COMPONENT_UI));
        };
        document.head.appendChild(script);
      });
      return loading;
    }

    // Avisa quem pediu a busca que ela não vai abrir. O header escuta para navegar até
    // `/busca/` (`SiteHeaderIsland.tsx`). O sinal é um EVENTO e não um prazo: o bundle tem
    // 171 KB, e qualquer tempo fixo que cubra uma conexão lenta seria longo demais para
    // uma rápida — foi o defeito da primeira versão desta task, que esperava 100ms fixos e
    // abandonava um carregamento ainda em andamento.
    function announceUnavailable() {
      document.dispatchEvent(new CustomEvent("artificio:search-unavailable"));
    }

    // O par do aviso acima: sem ele, quem escuta o fracasso ficaria escutando para sempre
    // no caso feliz, que é o comum.
    function announceOpened() {
      document.dispatchEvent(new CustomEvent("artificio:search-opened"));
    }

    async function open() {
      var modal = document.getElementById("search-modal");
      if (!modal) {
        announceUnavailable();
        return;
      }
      try {
        await loadComponentUI();
        // `customElements.whenDefined` porque o upgrade do elemento já presente no DOM
        // acontece depois do `onload` do script, não junto com ele: chamar `open()` antes
        // do upgrade chamaria um método que ainda não existe.
        await customElements.whenDefined("pagefind-modal");
        var element = modal as HTMLElement & { open?: () => void; isOpen?: boolean };
        element.open?.();
        // O upgrade pode definir o elemento sem que ele abra (`open` ausente numa versão
        // futura do bundle, por exemplo). Confirmar o estado, não presumir pela ausência
        // de exceção.
        if (element.isOpen) announceOpened();
        else announceUnavailable();
      } catch (error) {
        console.error("Busca indisponível", error);
        announceUnavailable();
      }
    }

    document.addEventListener("click", function (e) {
      var target = e.target;
      if (!(target instanceof Element)) return;
      if (target.id === "search-toggle" || target.closest("#search-toggle")) open();
    });
    document.addEventListener("artificio:open-search", open);

    // Atalhos `/` e Ctrl/Cmd+K. O Component UI registra `Esc` para fechar sozinho
    // (medido na classe do `pagefind-modal`), então só a abertura fica aqui.
    document.addEventListener("keydown", function (e) {
      if (e.key !== "/" && !(e.key === "k" && (e.metaKey || e.ctrlKey))) return;
      var tag = (document.activeElement && document.activeElement.tagName) || "";
      if (tag === "INPUT" || tag === "TEXTAREA") return;
      e.preventDefault();
      open();
    });
  })();
</script>
