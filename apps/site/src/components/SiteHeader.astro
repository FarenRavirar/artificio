---
/*
  Header do `site` (T3.5d + T3.5g, spec 102).

  Este arquivo resolve os dados de navegação no build do Astro e entrega para a ilha, que
  desde 2026-09-21 é só um adaptador: quem renderiza o `<header>` é o `Header` de
  `@artificio/ui`, o mesmo dos outros 6 apps.

  A marca saiu daqui junto com a troca — o `Header` a importa de `packages/ui/src/brand.ts`
  (`Header.tsx:353-368`), então `logos` e `BRAND_NAME` não precisam mais atravessar a ponte.

  ⚠️ NÃO reabrir `<header>` nem `.artificio-header-main` aqui. Foi assim até 2026-09-14 e
  quebrava o layout mobile: junto do componente hidratado o Astro injeta um `<style>` e um
  `<script>` como IRMÃOS dele, dentro do mesmo pai. Medido no beta: com o grid aberto aqui,
  os itens eram `<style>`, `<script>`, nav e tools — 5 para 4 colunas (3 em ≤860px), e as
  ferramentas públicas caíam fora da área visível no celular. A nota completa está no
  `return` de `SiteHeaderIsland.tsx`.

  Mesmo padrão de `apps/links` (`PortalHeader.astro` → `<LinksHeader client:load />`), o
  único outro header por ilha do repo e o único que não tinha o defeito.

  ⚠️ Os 11 links do nav PRECISAM continuar no HTML servido (aceite 13). Eles chegam como
  props de dado estático e são renderizados no SSR do React — `client:idle` hidrata
  depois, mas a marcação já saiu no HTML. NÃO trocar por `client:only`.
*/
import { MODULES, SECTIONS } from "../lib/content";
import { BRAND_ORIGIN } from "@artificio/config";
import SiteHeaderIsland from "./SiteHeaderIsland";
interface Props {
  currentHref?: string;
}
const { currentHref } = Astro.props;
/* `pathname` vem do Astro porque a ilha faz SSR: no servidor não existe `location`, e
   ler o caminho só depois da hidratação faria o `aria-current` aparecer tarde (ou nunca,
   para o crawler). `BRAND_ORIGIN` marca o item "Portal", que é este próprio site. */
const pathname = Astro.url.pathname;
---
<SiteHeaderIsland
  client:idle
  modules={MODULES}
  sections={SECTIONS}
  currentHref={currentHref}
  siteOrigin={BRAND_ORIGIN}
  pathname={pathname}
/>
