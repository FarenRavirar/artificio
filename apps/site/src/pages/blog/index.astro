---
import Base from "../../layouts/Base.astro";
import Card from "../../components/Card.astro";
import Paginador from "../../components/Paginador.astro";
import { postsDaFatia, totalFatias, allCategories } from "../../lib/content";

const cats = allCategories();
/* Fatia 1 do acervo (T3.5c). Antes renderizava os 126 posts de uma vez — 184.714 B.
   `/blog/` continua sendo a página 1: não existe `/blog/1/`, por determinação do
   mantenedor ("URL É BLOG/2"), e por isso mantém title/description/h1 SEM sufixo de
   página — quem ganha sufixo são as fatias 2..N. */
const fatia = postsDaFatia(1);
const total = totalFatias();
---
<Base
  title="Blog — Artifício RPG"
  canonical="https://artificiorpg.com/blog/"
  description="Todos os artigos do Artifício RPG: notícias, análises, guias e traduções."
>
  <main class="container">
    <header class="archive-head">
      <span class="kicker">Blog</span>
      <h1>Todos os artigos</h1>
      <nav class="cat-pills" aria-label="Categorias">
        {cats.map((c) => (
          <a class="cat-pill" href={`/blog/categoria/${c.slug}/`}>{c.name}<span>{c.count}</span></a>
        ))}
      </nav>
    </header>
    <section class="grid">{fatia.map((p) => <Card post={p} />)}</section>
    <Paginador current={1} total={total} />
  </main>
</Base>
