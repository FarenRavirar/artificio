---
import Base from "../../layouts/Base.astro";
import Card from "../../components/Card.astro";
import { posts, getPost, related } from "../../lib/content";
import { articleLd, breadcrumbLd, SITE } from "@artificio/content";
import { PostConversation } from "../../components/comments/PostConversation.tsx";

export function getStaticPaths() {
  return posts.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = getPost(slug as string);
if (!post) return Astro.redirect("/404");

const cat = post.cats[0];
const catHref = cat ? `/blog/categoria/${cat.slug}/` : "";
const rel = related(post);
// canonical = URL final no domínio raiz (D047/D019); preserva /blog/<slug>/ no cutover.
// override editorial (admin) tem precedência.
const canonical = post.seo.canonical || `${SITE.origin}/blog/${post.slug}/`;
const crumbs = [
  { name: "Início", url: `${SITE.origin}/` },
  { name: "Blog", url: `${SITE.origin}/blog/` },
  ...(cat ? [{ name: cat.name, url: `${SITE.origin}/blog/categoria/${cat.slug}/` }] : []),
  { name: post.title, url: canonical },
];
const jsonld = [
  articleLd({
    headline: post.title,
    url: canonical,
    description: post.seo.description,
    datePublished: post.date,
    image: post.image || undefined,
    section: cat?.name,
  }),
  breadcrumbLd(crumbs),
];
---
<Base
  title={`${post.seo.title ?? post.title} — Artifício RPG`}
  description={post.seo.description}
  canonical={canonical}
  ogType="article"
  image={post.seo.ogImage || post.image}
  ogTitle={post.seo.ogTitle}
  ogDescription={post.seo.ogDescription}
  twitterCard={post.seo.twitterCard}
  noindex={post.seo.noindex}
  jsonld={jsonld}
>
  <main class="article-wrap">
    <nav class="breadcrumb" aria-label="Trilha">
      <a href="/">Início</a> <span>/</span> <a href="/blog/">Blog</a>
      {cat && (<><span>/</span> <a href={catHref}>{cat.name}</a></>)}
    </nav>
    <article class="article" data-pagefind-body>
      <header class="article-head">
        {cat && <a class="chip" href={catHref}>{cat.name}</a>}
        <h1>{post.title}</h1>
        <div class="article-meta">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
          <span>{post.readingTime} min de leitura</span><span class="dot">·</span><span>{post.dateFmt}</span>
        </div>
      </header>
      {post.image && (
        <figure class="article-cover"><img src={post.image} alt="" width="1200" height="630" /></figure>
      )}
      <div class="article-body prose" set:html={post.contentHtml} />
      {post.tags.length > 0 && (
        <div class="tags">
          {post.tags.map((t) => <a class="tag" href={`/blog/tag/${t.slug}/`}>#{t.name}</a>)}
        </div>
      )}
    </article>
    {post.toc.length > 0 && (
      <aside class="toc-rail">
        <nav class="toc" aria-label="Conteúdo">
          <span class="toc-title">Neste artigo</span>
          <ul>
            {post.toc.map((t) => (
              <li class={`toc-l${t.level}`}><a href={`#${t.id}`}>{t.text}</a></li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
  </main>
  {/*
    T6.4 (spec 090) — conversa abaixo do artigo.

    `client:visible` e não `client:load`: quem abre o post para ler o texto não
    paga o bundle da conversa. A página segue estática (SSG) — só esta seção
    hidrata, e apenas quando entra no viewport.

    `realm` NÃO é passado, de propósito: quem o determina é a credencial de
    serviço no servidor (`contrato-http-v1.md` §1.1 — "`realm` e `source_app`
    saem dela, nunca do payload"), e o `downloads` faz igual (nunca passa o
    parâmetro, `MaterialConversation.tsx`). Aqui ele só participa da chave do
    cache local; um valor vindo do bundle poderia divergir do realm real da
    credencial, que é o caso que a chave existe para evitar.
  */}
  <PostConversation client:visible postId={String(post.id)} />
  <section class="related container">
    <div class="section-head"><h2>Leia também</h2></div>
    <div class="grid">{rel.map((r) => <Card post={r} />)}</div>
  </section>
</Base>
