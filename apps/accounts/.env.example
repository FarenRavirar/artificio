DATABASE_URL=postgres://admin:admin@accounts-db:5432/artificio_auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://accounts.artificiorpg.com/api/auth/google/callback
JWT_SECRET=change-me-at-least-32-chars
JWT_REFRESH_SECRET=change-me-at-least-32-chars-refresh
# Opcional: primeiro admin global. Valor real existe só no .env da VM.
ACCOUNTS_BOOTSTRAP_ADMIN_EMAIL=
COOKIE_DOMAIN=.artificiorpg.com
PUBLIC_URL=https://accounts.artificiorpg.com
PORT=3000
# WS3 admin secrets + spec 083 (GET /internal/users/:id, downloads resolve e-mail do autor)
SERVICE_SECRET=

# Troca de foto de perfil (PATCH /api/account/avatar). Opcionais: sem elas o app
# sobe normal e so a rota de avatar devolve 503. Sao as MESMAS credenciais que
# mesas/downloads/links usam (conta Cloudinary unica do projeto) — copiar de
# apps/mesas/.env na VM, nao gerar novas.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
