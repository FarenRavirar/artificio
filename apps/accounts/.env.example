DATABASE_URL=postgres://admin:admin@accounts-db:5432/artificio_auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://accounts.artificiorpg.com/api/auth/google/callback
JWT_SECRET=change-me-at-least-32-chars
JWT_REFRESH_SECRET=change-me-at-least-32-chars-refresh
# Opcional: primeiro admin global. Valor real existe só no .env da VM.
ACCOUNTS_BOOTSTRAP_ADMIN_EMAIL=
COOKIE_DOMAIN=.artificiorpg.com
PUBLIC_URL=https://accounts.artificiorpg.com
PORT=3000
# T2.3 (spec 090) — assinatura do cursor de leitura em arvore de comentarios.
# Obrigatoria (`:?` no compose de prod): sem ela o accounts NAO sobe. Chave
# DEDICADA, min 32 chars, nunca derivada do JWT_SECRET (`spec.md` 8d-i,
# precedente REV-023). Gerar com `openssl rand -base64 48` e inserir por SSH em
# /opt/artificio/apps/accounts/.env ANTES do deploy — nao passa por GitHub
# Secrets. Um arquivo so: accounts e PROD-only (D042) e o deploy aborta com
# env=beta, entao nao ha `.env.beta` a preencher aqui.
ACCOUNTS_COMMENT_CURSOR_KEY=change-me-at-least-32-chars-cursor
# WS3 admin secrets + spec 083 (GET /internal/users/:id, downloads resolve e-mail do autor).
# O `accounts.` VALIDA credencial de servico, nao consome: nao ha variavel de
# segredo a preencher aqui. A autenticacao resolve `community_service_credential`
# no banco (migration 007). Emitir credencial de consumidor com
# `node dist/scripts/serviceCredentialAdmin.js issue`.
# SERVICE_SECRET foi removido em 2026-08-07 (T2.2a-op, passo 6).

# Troca de foto de perfil (PATCH /api/account/avatar). Opcionais: sem elas o app
# sobe normal e so a rota de avatar devolve 503. Sao as MESMAS credenciais que
# mesas/downloads/links usam (conta Cloudinary unica do projeto) — copiar de
# apps/mesas/.env na VM, nao gerar novas.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
