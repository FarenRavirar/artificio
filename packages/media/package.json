{
  "name": "@artificio/media",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./image-kinds": {
      "types": "./dist/imageKinds.d.ts",
      "import": "./dist/imageKinds.js",
      "require": "./dist/imageKinds.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "cloudinary": "^2.9.0",
    "ipaddr.js": "^2.4.0"
  },
  "devDependencies": {
    "vitest": "^3.2.2"
  }
}
